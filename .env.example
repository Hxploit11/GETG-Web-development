# The build reads process environment variables. No secret belongs in site configuration.
SITE_URL=https://getg.com
SITE_INDEXABLE=false
# Set to a public HTTPS form-service endpoint when the real inbox is ready.
FORM_ENDPOINT=
CONTACT_EMAIL=tom@sterlingbrandcleaners.com
# Optional cookieless analytics. Disabled unless both values are present.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=
